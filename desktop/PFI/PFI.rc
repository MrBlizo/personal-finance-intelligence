// Application icon (shown in Explorer, taskbar and Start menu)
1 ICON "Assets\\pfi.ico"

1 VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ibrahim"
            VALUE "FileDescription", "Personal Finance Intelligence"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "PFI"
            VALUE "OriginalFilename", "PFI.exe"
            VALUE "ProductName", "Personal Finance Intelligence"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
