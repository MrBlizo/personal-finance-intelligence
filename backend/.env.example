# Copy this file to `.env` (same folder) for development.

# Option A (recommended): private database cluster using your installed
# PostgreSQL 18 programs. No user/database setup needed; the cluster is
# created automatically in PFI_DATA_DIR on first start.
PFI_PG_BIN=C:\Program Files\PostgreSQL\18\bin
PFI_PG_PORT=54329

# Option B: use an existing PostgreSQL server instead. Comment out
# PFI_PG_BIN above and set the connection URL:
# PFI_DATABASE_URL=postgresql+psycopg://pfi:YOUR_PASSWORD@localhost:5432/pfi

# Keep development data separate from the installed app's data
# (relative to the backend folder).
PFI_DATA_DIR=.devdata

# Reporting currency for a new database
PFI_BASE_CURRENCY_DEFAULT=CHF

# Leave empty in development (no login token, CORS for Next.js dev server)
PFI_API_TOKEN=
